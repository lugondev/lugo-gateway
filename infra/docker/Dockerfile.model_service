# infra/docker/Dockerfile.model_service
# One image for every local engine; SERVICE_KIND + SERVICE_ENGINE pick which
# one this container runs. Reuses the gateway's providers -- hence the same
# system deps and the api_gateway package on PYTHONPATH.
FROM python:3.11-slim

# libsndfile1: soundfile (VieNeu TTS audio I/O). libopus0: Opus transport.
# libatomic1: vosk's libvosk.so dlopen-fails without it on Debian slim images
# ("cannot open shared object file") -- python:3.11-slim omits it by default.
# libgomp1: OpenMP runtime the compiled qwen3-asr-cli binary dynamically links
# against. Installed explicitly here (not just pulled in transitively by g++
# below) so it survives the `apt-get purge g++ && apt-get autoremove` in the
# GGUF build step -- autoremove drops anything only auto-installed, and g++'s
# copy of libgomp1 is exactly that, which left the final image's cli failing
# at runtime with "error while loading shared libraries: libgomp.so.1".
RUN apt-get update \
    && apt-get install -y --no-install-recommends libsndfile1 libopus0 libatomic1 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Qwen3-ASR GGUF/CPU engine: build the qwen3-asr-cli binary + convert the GGUF only
# when this image is for that engine. Off by default so every other engine's image
# skips the C++ toolchain and the multi-minute compile. Enable with:
#   docker build --build-arg BUILD_QWEN3_ASR_GGUF=1 -f infra/docker/Dockerfile.model_service .
#
# Deliberately placed BEFORE `COPY apps ./apps` below and scoped to a single COPY of
# just this script -- this layer is the expensive part of the image (C++ compile +
# ~1.2GB HF download), and putting it after a COPY of the whole monorepo meant any
# unrelated commit anywhere under apps/ (a different engine, the web client, ...)
# busted the cache and forced a full from-scratch rebuild every deploy. Scoping the
# COPY to this one file means the layer only invalidates when the script itself, the
# apt package list, or the base image changes.
#
# Note: predict-woo/qwen3-asr.cpp has no compatible prebuilt GGUF, so the build
# script CONVERTS from the Alibaba HF weights -- needs torch/safetensors/tqdm/gguf/
# huggingface_hub, none of which are installed yet at this point in the build (the
# script pip-installs each on demand against the bare system python3, several extra
# minutes + ~200MB). The conversion also downloads the ~1.2GB safetensors at build
# time. For a slimmer prod image, build with =1 once to produce the .gguf, then bake
# or mount that file and set STT_QWEN3_ASR_GGUF_BINARY_PATH / the registry
# default_model to it instead.
ARG BUILD_QWEN3_ASR_GGUF=0
ARG QWEN3_ASR_GGUF_HF_MODEL=Qwen/Qwen3-ASR-1.7B
COPY apps/model_service/scripts/build_qwen3_asr_cpp.sh apps/model_service/scripts/build_qwen3_asr_cpp.sh
RUN if [ "$BUILD_QWEN3_ASR_GGUF" = "1" ]; then \
        apt-get update \
        && apt-get install -y --no-install-recommends git cmake make g++ curl ca-certificates \
        && bash apps/model_service/scripts/build_qwen3_asr_cpp.sh "$QWEN3_ASR_GGUF_HF_MODEL" \
        && cmake --install apps/model_service/vendor/qwen3-asr.cpp/build \
        && apt-get purge -y git cmake make g++ && apt-get autoremove -y \
        && rm -rf /var/lib/apt/lists/* \
        # The conversion's only output we need is the .gguf under vendor/models/ --
        # the multi-GB HF source snapshot it downloaded to produce that, plus the
        # torch/gguf/etc. packages installed on-demand to run the conversion, are
        # single-use here (unlike a local dev checkout, where the HF cache is
        # shared with other engines -- see the script's own comment). Both are
        # pure build-time disk pressure on a Coolify host that already ran out of
        # space mid-build; drop them once the .gguf exists.
        && rm -rf /root/.cache/huggingface /root/.cache/pip \
        && pip uninstall -y torch safetensors tqdm gguf huggingface_hub 2>/dev/null || true; \
    fi

# Torch-backed engines (omnivoice, voxcpm2, the non-GGUF qwen3_asr) pull torch
# transitively, and PyPI's default linux wheel bundles the whole CUDA runtime
# (~2.5GB) even on a machine that has no GPU. Pre-installing from PyTorch's own
# CPU index makes the later `pip install ".[...]"` find the requirement already
# satisfied and keeps the CPU images ~2GB smaller:
#   --build-arg TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# Deliberately its own layer above the COPY of the source tree: torch is by far
# the largest download in these images and must not be re-fetched every time app
# code changes. Empty (the default) skips this entirely -- the torch-free engines
# (vieneu, vosk, whisper_local, qwen3_asr_gguf) never install torch at all.
#
# torchaudio is installed here too, from the SAME index. It isn't needed for its
# own sake -- omnivoice/voxcpm pull it in -- but its wheel contains a C extension
# compiled against one exact torch build, and pip would otherwise satisfy it from
# PyPI against the +cpu torch installed here. The mismatch is not a resolver
# error; it's an ImportError at runtime, well after the image builds clean:
#   OSError: Could not load this library: .../torchaudio/lib/_torchaudio.abi3.so
ARG TORCH_INDEX_URL=""
RUN if [ -n "$TORCH_INDEX_URL" ]; then \
        pip install --no-cache-dir --index-url "$TORCH_INDEX_URL" torch torchaudio; \
    fi

COPY pyproject.toml README.md ./
COPY apps ./apps

# Which engine's dependencies this image carries. The default keeps the vieneu
# TTS + Opus set every existing compose file was built against; per-engine images
# pass their own (e.g. --build-arg PIP_EXTRAS=whisper,opus). See
# [project.optional-dependencies] in pyproject.toml for the full list.
ARG PIP_EXTRAS=tts,opus
RUN pip install --no-cache-dir ".[${PIP_EXTRAS}]"

ENV PYTHONPATH=/app/apps/api_gateway:/app/apps \
    PYTHONUNBUFFERED=1 \
    SERVICE_PORT=8100 \
    ARTIFACTS_DIR=/tmp/artifacts \
    DATABASE_URL=sqlite+aiosqlite:////tmp/model_service.db

# ARTIFACTS_DIR: app/services/artifacts.py mkdirs at import time and this
# service never serves artifacts -- keep it off the image's working tree.
# DATABASE_URL: three providers still read system_config_store for inert
# defaults (glossary path, default voice); point them at a throwaway file so
# nothing tries to write into a read-only rootfs.

EXPOSE 8100
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request,os;urllib.request.urlopen(f'http://127.0.0.1:{os.environ[\"SERVICE_PORT\"]}/health').read()"

# --factory: main.py has no module-level `app`, so that importing it in tests
# doesn't run load_config() and die on missing env.
CMD ["sh", "-c", "uvicorn model_service.app.main:create_app --factory --host 0.0.0.0 --port ${SERVICE_PORT}"]
