APP_NAME=speech-text-transformer
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Comma-separated origins, or * for all
CORS_ALLOW_ORIGINS=*

# Browser control-panel login (single shared password). Empty = auth disabled
# (fine for local dev). Set it to require a login before the control panel loads.
ADMIN_PASSWORD=
# Cookie-signing secret for the login session. Optional — if left empty (with
# ADMIN_PASSWORD set) a random secret is generated at process startup, so sessions
# reset on every restart. Set it explicitly for stable sessions across restarts /
# multiple workers.
SESSION_SECRET=

DEFAULT_STT_ENGINE=vosk
DEFAULT_TTS_ENGINE=omnivoice

OMNIVOICE_PATH=/Users/lugon/code/OmniVoice
OMNIVOICE_MODEL_ID=k2-fsa/OmniVoice
# Empty = auto-detect (cuda/mps/cpu)
OMNIVOICE_DEVICE=
OMNIVOICE_DTYPE=float16
# Python interpreter able to import omnivoice (its own venv). Empty = {OMNIVOICE_PATH}/.venv/bin/python
OMNIVOICE_PYTHON=
OMNIVOICE_TIMEOUT_SECONDS=600

# VieNeu-TTS (pip install vieneu) — Vietnamese TTS, 48kHz. Optional default preset voice:
DEFAULT_TTS_ENGINE_VOICE=

# Where generated audio artifacts are stored (served at /artifacts)
ARTIFACTS_DIR=artifacts

STT_MODEL_DIR=models/stt
VOSK_MODEL_PATH=models/stt/vosk-model-small-en-us-0.15
# Sample rate (Hz) for the streaming audio contract (PCM16 mono)
STT_STREAM_SAMPLE_RATE=16000

# Model id: standard sizes (small | medium | large-v3) or VinAI Vietnamese
# fine-tune phowhisper-{tiny,base,small,medium,large} — far better Vietnamese.
WHISPER_LOCAL_MODEL=phowhisper-medium
WHISPER_LOCAL_DEVICE=cpu
WHISPER_LOCAL_COMPUTE_TYPE=int8
# Decoding knobs. condition_on_previous_text off avoids hallucination drift across
# silent gaps; initial prompt seeds Vietnamese orthography (empty = off).
WHISPER_BEAM_SIZE=1
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
WHISPER_INITIAL_PROMPT=
# Apple-Silicon GPU STT (engine "whisper_mlx", ~7x faster than CPU). Build the model
# with scripts/convert_phowhisper_mlx.sh, then optionally set CONVERSATION_STT_ENGINE=whisper_mlx.
WHISPER_MLX_MODEL_PATH=models/stt/phowhisper-medium-mlx

# Extra STT/TTS engine(s) to warm at boot alongside CONVERSATION_STT_ENGINE /
# CONVERSATION_TTS_ENGINE, comma-separated. Set this to whatever engine a device
# pins via ?stt_engine=.../?tts_engine=... (e.g. an RPi client's config.yaml
# session.stt_engine) — otherwise boot warm-up preloads the wrong model and that
# device's first turn each restart still pays the full cold-load cost.
EXTRA_WARMUP_STT_ENGINES=
EXTRA_WARMUP_TTS_ENGINES=

# STT audio preprocessing defaults (overridable per request via denoise/vad)
STT_VAD_ENABLED=true
STT_NOISE_REDUCE_ENABLED=false
STT_NOISE_REDUCE_AMOUNT=0.85
# VAD backend: energy (built-in) | silero (pip install silero-vad) | pyannote (gated, needs token)
STT_VAD_BACKEND=energy
# pyannote runs locally; the token only downloads gated weights once (accept terms on HF).
PYANNOTE_VAD_MODEL=pyannote/segmentation-3.0
PYANNOTE_AUTH_TOKEN=

# Conversation (voice turn-taking)
CONVERSATION_SILENCE_MS=700
CONVERSATION_MIN_SPEECH_MS=300
CONVERSATION_RMS_THRESHOLD=0.015
CONVERSATION_MAX_UTTERANCE_MS=30000
# Optional OpenAI-compatible chat endpoint for real replies (Ollama/LM Studio/vLLM/OpenAI).
# Leave base url empty to use the built-in echo responder.
CONVERSATION_LLM_BASE_URL=
CONVERSATION_LLM_API_KEY=
CONVERSATION_LLM_MODEL=gpt-3.5-turbo

# OpenAI-compatible Whisper service endpoint, example: https://api.openai.com/v1
WHISPER_SERVICE_BASE_URL=
WHISPER_SERVICE_API_KEY=
WHISPER_SERVICE_MODEL=whisper-1

# Eventlab (or any compatible provider) endpoint, example: https://api.eventlab.ai/v1
EVENTLAB_BASE_URL=
EVENTLAB_API_KEY=
EVENTLAB_MODEL=whisper-1

REMOTE_STT_TIMEOUT_SECONDS=60
