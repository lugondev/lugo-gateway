APP_NAME=lugo-gateway
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Comma-separated origins, or * for all
CORS_ALLOW_ORIGINS=*

# How many reverse proxies of YOUR OWN sit in front of this app. The login,
# signup and device-pairing rate limiters key on the client address; behind a
# proxy the socket peer is the proxy, so every client shares one key and the
# per-client limit silently becomes a global one. Set this to 1 behind a single
# reverse proxy (nginx, Traefik, Coolify, Cloudflare) so the real client address
# is read from the trusted tail of X-Forwarded-For.
# Leave at 0 when the app is exposed directly: trusting the header without a
# proxy in front lets any caller forge a fresh limiter key per request.
TRUSTED_PROXY_HOPS=0

# Browser control-panel login (single shared password). Empty = auth disabled
# (fine for local dev). Set it to require a login before the control panel loads.
ADMIN_PASSWORD=
# Cookie-signing secret for the login session. Optional — if left empty (with
# ADMIN_PASSWORD set) a random secret is generated at process startup, so sessions
# reset on every restart. Set it explicitly for stable sessions across restarts /
# multiple workers.
SESSION_SECRET=

# STT/TTS engine choice, Whisper/OmniVoice/Qwen3 model settings, conversation LLM
# endpoint, remote STT provider endpoints/keys, conversation tuning, and VAD/noise
# preprocessing all moved to the admin UI (System tab > System settings). They are
# no longer read from .env — see docs/superpowers/specs/2026-07-13-env-to-admin-system-settings-design.md

# Where voice-clone reference audio is stored on disk. Not served over HTTP --
# reference audio is only read back in-process (see app/services/artifacts.py).
ARTIFACTS_DIR=artifacts
